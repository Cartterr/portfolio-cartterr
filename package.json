{
  "name": "cartterr-portfolio",
  "version": "1.0.0",
  "description": "José Carter's portfolio for reliable AI, data, and autonomous systems",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "test": "node --test scripts/production-contract.test.mjs && npm run test --workspace backend && npm run test --workspace frontend && npm run build && npm run smoke:compiled --workspace backend",
    "test:frontend": "npm run test --workspace frontend",
    "test:backend": "npm run test --workspace backend",
    "lint": "npm run lint --workspace frontend",
    "lint:frontend": "npm run lint --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "start": "npm run start:backend",
    "start:frontend": "npm run preview --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "smoke:compiled": "npm run smoke:compiled --workspace backend",
    "install:all": "npm install",
    "type-check": "npm run type-check --workspace frontend && npm run type-check --workspace backend",
    "type-check:frontend": "npm run type-check --workspace frontend",
    "type-check:backend": "npm run type-check --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  },
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "express",
    "full-stack",
    "jose-carter"
  ],
  "author": "José Carter Arriagada <jose.carterx@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cartterr/portfolio-cartterr.git"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  }
}
