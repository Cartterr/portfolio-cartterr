{
  "name": "cartterr-portfolio-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for José Carter's portfolio website",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:compiled": "node scripts/smoke-compiled.mjs",
    "clean": "rm -rf dist",
    "prepare:images": "mkdir -p public/images"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "2.8.6",
    "dotenv": "^16.3.1",
    "express": "4.22.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "9.0.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.25",
    "@types/morgan": "^1.9.9",
    "@types/node": "20.19.37",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.0",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "ts-node": "^10.9.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "0.34.6"
  },
  "resolutions": {
    "qs": "6.15.2"
  },
  "keywords": [
    "portfolio",
    "api",
    "express",
    "typescript",
    "jose-carter"
  ],
  "author": "José Carter Arriagada",
  "license": "MIT"
}
